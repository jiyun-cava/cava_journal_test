<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {%- set pageTitle = (title + " – " + site.name) if title else site.name %}
  {%- set pageDesc = (description or (content | excerpt(160) if layout == "layouts/article.njk") or site.description) %}
  {%- set pageImage = (cover | absUrl) if cover else (site.logo | absUrl) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ page.url | absUrl }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ page.url | absUrl }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/article.njk' else 'website' }}">
  <meta property="og:image" content="{{ pageImage }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- for j in site.journals %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} – {{ j.title }}" href="/blogs/{{ j.key }}.atom">
  {%- endfor %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{{ bodyClass }}" data-base="{{ basePath }}">
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
