<header class="site-header">
  <a class="logo" href="/" aria-label="{{ site.name }} home">
    {%- if site.logo %}<img src="{{ site.logo }}" alt="{{ site.name }}" width="450" height="278">{% else %}<span>{{ site.name }}</span>{% endif -%}
  </a>
  <form class="site-search" action="/" role="search">
    <label class="visually-hidden" for="site-q">Search</label>
    <input id="site-q" name="q" type="search" placeholder="Search" autocomplete="off" enterkeyhint="search">
  </form>
  <a class="about-link" href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}>ABOUT</a>
</header>
