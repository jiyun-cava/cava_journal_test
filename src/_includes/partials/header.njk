<header class="site-header">
  <a class="logo" href="/" aria-label="{{ site.name }} home">
    {%- if site.logo %}<img src="{{ site.logo }}" alt="{{ site.name }}" width="450" height="278">{% else %}<span>{{ site.name }}</span>{% endif -%}
  </a>
  <form class="site-search" action="/search/" role="search">
    <label class="visually-hidden" for="site-q">Search</label>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6"/></svg>
    <input id="site-q" name="q" type="search" placeholder="Search" autocomplete="off">
  </form>
</header>
